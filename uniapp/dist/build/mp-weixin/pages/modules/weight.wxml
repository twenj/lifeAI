<view class="page data-v-e3128fbb"><page-navbar wx:if="{{a}}" class="data-v-e3128fbb" u-i="e3128fbb-0" bind:__l="__l" u-p="{{a}}"/><view class="body data-v-e3128fbb"><view class="form-card data-v-e3128fbb"><view class="form-title data-v-e3128fbb">记录体重</view><view class="hint data-v-e3128fbb">一天可以记录多次，日期和时间都可以自己选</view><picker class="data-v-e3128fbb" mode="date" value="{{c}}" bindchange="{{d}}"><view class="field data-v-e3128fbb">日期：{{b}}</view></picker><picker class="data-v-e3128fbb" mode="time" value="{{f}}" bindchange="{{g}}"><view class="field data-v-e3128fbb">时间：{{e}}</view></picker><input class="input data-v-e3128fbb" type="digit" placeholder="体重（kg）" value="{{h}}" bindinput="{{i}}"/><input class="input data-v-e3128fbb" placeholder="备注（可选）" maxlength="500" value="{{j}}" bindinput="{{k}}"/><view class="primary-button data-v-e3128fbb" bindtap="{{l}}">保存记录</view></view><view class="section-title data-v-e3128fbb">历史记录</view><view wx:if="{{m}}" class="empty data-v-e3128fbb">还没有体重记录</view><view wx:for="{{n}}" wx:for-item="item" wx:key="e" class="record-card data-v-e3128fbb"><view class="record-main data-v-e3128fbb"><view class="record-value data-v-e3128fbb">{{item.a}} kg</view><view class="record-date data-v-e3128fbb">{{item.b}}{{item.c}}</view></view><view class="delete data-v-e3128fbb" bindtap="{{item.d}}">删除</view></view></view></view>